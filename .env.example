# ===================================================================
# Ogak USSD Platform — Environment Configuration
# Copy this file to .env and fill in your values
# ===================================================================

# ----- Application -----
APP_NAME=ogak-ussd
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-random-64-char-hex-string
APP_ENCRYPTION_KEY=change-this-to-a-32-byte-hex-key

# ----- Server Ports -----
USSD_PORT=8000
API_PORT=8001
ILP_PORT=8002
ADMIN_PORT=8003
# No simulator ports or services in production compose / image.
# All testing of the USSD callback must be done against a real Africa's Talking application or by posting the exact AT payload shape to /api/v1/ussd/callback.

# ----- PostgreSQL -----
DATABASE_URL=postgresql+asyncpg://ogak:ogak_secret@localhost:5432/ogak_db
DATABASE_SYNC_URL=postgresql://ogak:ogak_secret@localhost:5432/ogak_db
POSTGRES_USER=ogak
POSTGRES_PASSWORD=ogak_secret
POSTGRES_DB=ogak_db

# ----- Redis -----
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_DB=1
REDIS_CACHE_DB=2

# ----- Africa's Talking -----
AT_USERNAME=sandbox
AT_API_KEY=your-africastalking-api-key
AT_USSD_SHORTCODE=*384*OGAK#
AT_SMS_SHORTCODE=OGAK
AT_ENVIRONMENT=sandbox

# ----- Flutterwave -----
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxx
FLW_SECRET_KEY=FLWSECK_TEST-xxxxx
FLW_ENCRYPTION_KEY=xxxxx
FLW_WEBHOOK_SECRET=xxxxx
FLW_BASE_URL=https://api.flutterwave.com/v3

# ----- Paystack -----
PAYSTACK_SECRET_KEY=sk_test_xxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
PAYSTACK_WEBHOOK_SECRET=xxxxx
PAYSTACK_BASE_URL=https://api.paystack.co

# ----- Quidax (Primary Exchange) -----
QUIDAX_SECRET_KEY=your-quidax-secret-key
QUIDAX_BASE_URL=https://www.quidax.com/api/v1
QUIDAX_WEBHOOK_SECRET=xxxxx

# ----- Busha (Secondary Exchange) -----
BUSHA_API_KEY=your-busha-api-key
BUSHA_SECRET_KEY=your-busha-secret-key
BUSHA_BASE_URL=https://api.busha.co/v2
BUSHA_WEBHOOK_SECRET=xxxxx

# ----- Binance (Tertiary Exchange) -----
BINANCE_API_KEY=your-binance-api-key
BINANCE_SECRET_KEY=your-binance-secret-key
BINANCE_BASE_URL=https://api.binance.com/api/v3

# ----- ILP Connector -----
ILP_CONNECTOR_ADDRESS=g.ogak.ng.connector
ILP_CONNECTOR_SECRET=change-this-ilp-secret
ILP_MAX_PACKET_AMOUNT=1000000000
ILP_ROUTE_EXPIRY_MS=30000
ILP_DEFAULT_SPREAD_BPS=150

# ----- KYC/AML -----
KYC_TIER1_TX_LIMIT_NGN=50000
KYC_TIER1_DAILY_LIMIT_NGN=500000
KYC_TIER2_TX_LIMIT_NGN=500000
KYC_TIER2_DAILY_LIMIT_NGN=5000000
KYC_TIER3_TX_LIMIT_NGN=5000000
KYC_TIER3_DAILY_LIMIT_NGN=50000000
BVN_VALIDATION_PROVIDER=flutterwave

# ----- USSD Session -----
USSD_SESSION_TTL_SECONDS=180
USSD_MAX_PIN_ATTEMPTS=3
USSD_PIN_LOCKOUT_SECONDS=1800

# ----- Rate Engine -----
RATE_CACHE_TTL_SECONDS=30
RATE_QUOTE_EXPIRY_SECONDS=120
RATE_SPREAD_BPS=150

# ----- Celery (Task Queue) -----
CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/4

# ----- Logging -----
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/ogak.log

# ----- CORS -----
CORS_ORIGINS=http://localhost:3000,http://localhost:8003
