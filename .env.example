# ===================================================================
# Ogak USSD Platform — Environment Configuration
# Copy this file to .env and fill in REAL production values.
# NEVER commit the populated .env file.
# ALL values below are intentionally blank or clearly marked.
# Do NOT use sandbox/test keys in production deployments.
# ===================================================================

# ----- Application -----
APP_NAME=ogak-ussd
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET
APP_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_KEY

# ----- Server Ports -----
USSD_PORT=8000
API_PORT=8001
ILP_PORT=8002
ADMIN_PORT=8003

# ----- PostgreSQL -----
DATABASE_URL=postgresql+asyncpg://ogak:REPLACE_PASSWORD@localhost:5432/ogak_db
DATABASE_SYNC_URL=postgresql://ogak:REPLACE_PASSWORD@localhost:5432/ogak_db
POSTGRES_USER=ogak
POSTGRES_PASSWORD=REPLACE_PASSWORD
POSTGRES_DB=ogak_db

# ----- Redis -----
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_DB=1
REDIS_CACHE_DB=2

# ----- Africa's Talking (PRODUCTION only — obtain from AT dashboard) -----
AT_USERNAME=REPLACE_WITH_YOUR_AT_PRODUCTION_USERNAME
AT_API_KEY=REPLACE_WITH_YOUR_AT_PRODUCTION_API_KEY
AT_USSD_SHORTCODE=*384*OGAK#
AT_SMS_SHORTCODE=OGAK
AT_ENVIRONMENT=production

# ----- Flutterwave (live keys only — sk_live_ prefix) -----
FLW_PUBLIC_KEY=FLWPUBK-REPLACE_WITH_LIVE_KEY
FLW_SECRET_KEY=FLWSECK-REPLACE_WITH_LIVE_KEY
FLW_ENCRYPTION_KEY=REPLACE_WITH_FLW_ENCRYPTION_KEY
FLW_WEBHOOK_SECRET=REPLACE_WITH_FLW_WEBHOOK_SECRET
FLW_BASE_URL=https://api.flutterwave.com/v3

# ----- Paystack (live keys only — sk_live_ prefix) -----
PAYSTACK_SECRET_KEY=sk_live_REPLACE_WITH_LIVE_KEY
PAYSTACK_PUBLIC_KEY=pk_live_REPLACE_WITH_LIVE_KEY
PAYSTACK_WEBHOOK_SECRET=REPLACE_WITH_PAYSTACK_WEBHOOK_SECRET
PAYSTACK_BASE_URL=https://api.paystack.co

# ----- Quidax (Primary Exchange — production API key) -----
QUIDAX_SECRET_KEY=REPLACE_WITH_QUIDAX_SECRET_KEY
QUIDAX_BASE_URL=https://www.quidax.com/api/v1
QUIDAX_WEBHOOK_SECRET=REPLACE_WITH_QUIDAX_WEBHOOK_SECRET

# ----- Busha (Secondary Exchange) -----
BUSHA_API_KEY=REPLACE_WITH_BUSHA_API_KEY
BUSHA_SECRET_KEY=REPLACE_WITH_BUSHA_SECRET_KEY
BUSHA_BASE_URL=https://api.busha.co/v2
BUSHA_WEBHOOK_SECRET=REPLACE_WITH_BUSHA_WEBHOOK_SECRET

# ----- Binance -----
BINANCE_API_KEY=REPLACE_WITH_BINANCE_API_KEY
BINANCE_SECRET_KEY=REPLACE_WITH_BINANCE_SECRET_KEY
BINANCE_BASE_URL=https://api.binance.com/api/v3

# ----- ILP Connector -----
ILP_CONNECTOR_ADDRESS=g.ogak.ng.connector
ILP_CONNECTOR_SECRET=REPLACE_WITH_ILP_SECRET_MIN_32_CHARS
ILP_MAX_PACKET_AMOUNT=1000000000
ILP_ROUTE_EXPIRY_MS=30000
ILP_DEFAULT_SPREAD_BPS=150

# ----- KYC/AML -----
KYC_TIER1_TX_LIMIT_NGN=50000
KYC_TIER1_DAILY_LIMIT_NGN=500000
KYC_TIER2_TX_LIMIT_NGN=500000
KYC_TIER2_DAILY_LIMIT_NGN=5000000
KYC_TIER3_TX_LIMIT_NGN=5000000
KYC_TIER3_DAILY_LIMIT_NGN=50000000
BVN_VALIDATION_PROVIDER=flutterwave

# ----- USSD Session -----
USSD_SESSION_TTL_SECONDS=180
USSD_MAX_PIN_ATTEMPTS=3
USSD_PIN_LOCKOUT_SECONDS=1800

# ----- Rate Engine -----
RATE_CACHE_TTL_SECONDS=30
RATE_QUOTE_EXPIRY_SECONDS=120
RATE_SPREAD_BPS=150

# ----- Celery (Task Queue) -----
CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/4

# ----- Logging -----
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/ogak.log

# ----- CORS -----
CORS_ORIGINS=https://admin.ogak.ng

# ----- Open Payments -----
# Set to your public HTTPS base URL (no trailing slash)
OP_PUBLIC_BASE_URL=https://api.ogak.ng
